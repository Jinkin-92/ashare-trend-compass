# A-Share Trend Compass 环境变量模板

# DSA 数据库路径（个股日线只读来源）
DSA_DB_PATH=../../data/stock_analysis.db

# 本地数据库路径（指标结果写入）
LOCAL_DB_PATH=./data/trend_compass.db

# 前端 JSON 输出目录
WEB_DATA_DIR=./web/data

# 日志目录
LOG_DIR=./data/logs

# akshare 请求限速（秒）
AKSHARE_SLEEP_MIN=2.0
AKSHARE_SLEEP_MAX=5.0

# 前端服务端口
WEB_PORT=8080
WEB_HOST=127.0.0.1

# 相对强度趋势箭头：用于计算 1 日/5 日前排名变化
RS_TREND_LOOKBACK_DAYS=1,5
